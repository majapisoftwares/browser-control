{
  "name": "majapi-browser",
  "version": "0.2.0",
  "description": "Harness-independent Chrome automation with visible AI tab groups",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majapisoftwares/browser-control.git"
  },
  "bin": {
    "majapi-browser": "cli/majapi-browser.mjs"
  },
  "files": [
    "bridge",
    "cli",
    "extension",
    "skill",
    "!extension/config.local.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node cli/majapi-browser.mjs setup",
    "start": "node bridge/server.mjs",
    "test": "node --test test/*.test.mjs",
    "browser": "node cli/browser.mjs",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}
